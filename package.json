{
  "name": "scratch-render",
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "description": "WebGL Renderer for Scratch 3.0",
  "author": "Massachusetts Institute of Technology",
  "license": "MPL-2.0",
  "homepage": "https://github.com/LLK/scratch-render#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/LLK/scratch-render.git"
  },
  "main": "./dist/node/scratch-render.js",
  "browser": "./src/index.js",
  "scripts": {
    "build": "rspack build",
    "docs": "jsdoc -c .jsdoc.json",
    "lint": "eslint .",
    "prepublishOnly": "rspack build",
    "prepublish-watch": "rspack build --watch",
    "start": "rspack serve",
    "tap": "tap --disable-coverage test/unit test/integration",
    "test": "eslint . && rspack build && tap --disable-coverage test/unit test/integration",
    "version": "json -f package.json -I -e \"this.repository.sha = '$(git log -n1 --pretty=format:%H)'\"",
    "watch": "rspack build --watch"
  },
  "devDependencies": {
    "@rspack/cli": "2.2.9",
    "@rspack/core": "2.2.9",
    "@rspack/dev-server": "2.2.1",
    "docdash": "2.0.2",
    "eslint": "8.57.1",
    "eslint-config-scratch": "9.0.3",
    "jsdoc": "4.0.5",
    "json": "9.0.6",
    "playwright-chromium": "1.64.0",
    "scratch-storage": "6.2.1",
    "scratch-vm": "5.0.300",
    "tap": "21.8.0"
  },
  "dependencies": {
    "@turbowarp/ancient-hull.js": "^0.2.13",
    "@turbowarp/nanolog": "1.0.1",
    "@turbowarp/scratch-svg-renderer": "1.1.0",
    "buffer": "6.0.3",
    "events": "3.3.0",
    "linebreak": "1.1.0",
    "scratch-render-fonts": "github:TurboWarp/scratch-render-fonts#master",
    "twgl.js": "7.0.0"
  },
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "playwright-chromium"
    ]
  }
}
